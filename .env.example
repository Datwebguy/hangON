# Server-side only. Never place these values in browser code.
ASSEMBLYAI_API_KEY=your_key_here
# Optional: force an AssemblyAI LLM Gateway model. By default HangON uses the first model your account can access.
# HANGON_LLM_MODEL=gemini-2.5-flash-lite
# Optional: absolute path to a local key file for start-with-key.mjs (keep outside the repo).
# HANGON_KEY_FILE=
# Required when NODE_ENV=production (the server refuses to sign sessions without it).
HANGON_SESSION_SECRET=replace_with_a_long_random_secret
HANGON_CONFIRMATION_SECRET=replace_with_a_separate_long_random_secret
# Required when NODE_ENV=production. Use an identity provider instead for multi-user deployments.
HANGON_OPERATOR_TOKEN=replace_with_a_real_operator_token
NODE_ENV=development
PORT=4180

# 32-byte hex or base64 key used to encrypt workspace webhook secrets at rest.
HANGON_INTEGRATION_ENCRYPTION_KEY=replace_with_a_32_byte_key

# Postgres (recommended). When set, calendar/requests/integrations/workspaces use Postgres.
# Local docker compose default:
# DATABASE_URL=postgres://hangon:hangon@localhost:5432/hangon
# For Vercel, use Neon / Supabase / Vercel Postgres and set the same env var.
# DATABASE_URL=
# DATABASE_POOL_MAX=5

# Resend confirmation emails (optional until you want live send).
# RESEND_API_KEY=re_xxx
# HANGON_EMAIL_FROM="HangON Bookings <bookings@yourdomain.com>"
