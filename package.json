{
  "name": "hangon",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:key": "node start-with-key.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test test/*.test.mjs",
    "video:studio": "remotion studio demo-video/src/index.jsx --public-dir=demo-video/public",
    "video:render": "remotion render demo-video/src/index.jsx HangONFinal demo-video/out/hangon-demo-final.mp4 --codec=h264 --crf=18 --public-dir=demo-video/public",
    "video:record": "node demo-video/rig/record.mjs demo-video/raw/take --grab",
    "video:edit": "node demo-video/rig/build-edl.mjs"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.524",
    "@remotion/cli": "^4.0.524",
    "@remotion/renderer": "^4.0.524",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.524"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
