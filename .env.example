# Server-side only. Never place these values in browser code.
ASSEMBLYAI_API_KEY=your_key_here
HANGON_SESSION_SECRET=replace_with_a_long_random_secret
HANGON_CONFIRMATION_SECRET=replace_with_a_separate_long_random_secret
# Required when NODE_ENV=production. Use an identity provider instead for multi-user deployments.
HANGON_OPERATOR_TOKEN=replace_with_a_real_operator_token
NODE_ENV=development
PORT=4180

# 32-byte hex or base64 key used to encrypt workspace webhook secrets at rest.
HANGON_INTEGRATION_ENCRYPTION_KEY=replace_with_a_32_byte_key
