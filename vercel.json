{
  "functions": {
    "server.mjs": {
      "includeFiles": "{*.html,*.css,*.js,*.png,data/*.json,domain/**}"
    },
    "api/index.mjs": {
      "includeFiles": "{server.mjs,*.html,*.css,*.js,*.png,data/*.json,domain/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api?pathname=/$1" }
  ]
}
